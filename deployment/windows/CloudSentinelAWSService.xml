<?xml version="1.0" encoding="UTF-8"?>

<service>

    <id>CloudSentinelAWSWorker</id>

    <name>CloudSentinel AWS Worker</name>

    <description>
        CloudSentinel AWS CloudTrail monitoring and security event processing worker.
    </description>

    <executable>%BASE%\dist\CloudSentinelAWSWorker.exe</executable>

    <workingdirectory>%BASE%\..\..</workingdirectory>

    <env name="AWS_CONFIG_FILE" value="C:\CloudSentinel-PKI\aws-config\config" />
    <env name="AWS_PROFILE" value="cloudsentinel-rolesanywhere" />
    <env name="AWS_REGION" value="ap-south-1" />

    <logpath>%BASE%\logs</logpath>

    <log mode="roll" />

    <onfailure action="restart" delay="10 sec" />

    <resetfailure>1 hour</resetfailure>

    <hidewindow>true</hidewindow>

    <serviceaccount>
        <prompt>console</prompt>
        <allowservicelogon>true</allowservicelogon>
    </serviceaccount>

</service>